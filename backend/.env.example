DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Media
MEDIA_URL=/media/
MEDIA_ROOT=media/

# Dev/Prod
ENVIRONMENT=development

# Admin
ADMIN_EMAIL=admin@cloudmart.local
ADMIN_PASSWORD=Admin@1234
