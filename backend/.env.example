DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=cloudmart
DB_USER=cloudmart_user
DB_PASSWORD=cloudmart_password
